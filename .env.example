# Optional: path to a dedicated Chrome/Chromium executable.
UC_BROWSER_EXECUTABLE=/path/to/dedicated/chrome

# Optional: override the default public-research user agent.
KEKMAXX_USER_AGENT=Kekmaxxing-MCP/0.1 (+public-source-research)

# Private local case storage; leave unset to use the per-user default.
# KEKMAXX_DATA_DIR=
# SEC requires a descriptive User-Agent with operator contact.
# KEKMAXX_USER_AGENT=
# Optional semantic comparison uses a local multilingual model only.
# KEKMAXX_EMBEDDING_MODEL=
